<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SignalSphere - Baseband & Broadband Visualized</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        mono: {
                            bg: '#000000',
                            card: '#0a0a0a',
                            border: '#262626',
                            accent: '#ffffff',
                            muted: '#a1a1aa'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        html {
            scroll-behavior: smooth;
        }

        /* High-Contrast Black & White Aesthetics */
        .glow-white {
            box-shadow: 0 0 25px rgba(255, 255, 255, 0.15);
        }
        .text-glow-white {
            text-shadow: 0 0 12px rgba(255, 255, 255, 0.8);
        }
        .glass-panel {
            background: rgba(10, 10, 10, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }
        
        /* Light Mode Glass Panel Overrides */
        .light .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(0, 0, 0, 0.12);
        }

        canvas {
            display: block;
            touch-action: none;
        }

        /* Smooth Scroll-Driven Reveal Animations */
        .reveal-on-scroll {
            opacity: 0;
            transform: translateY(24px);
            transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
            will-change: opacity, transform;
        }
        .reveal-on-scroll.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Custom monochrome range sliders */
        input[type=range] {
            accent-color: #ffffff;
        }
        .light input[type=range] {
            accent-color: #000000;
        }
    </style>
</head>
<body class="bg-black text-zinc-100 font-sans antialiased min-h-screen selection:bg-white selection:text-black transition-colors duration-500">

    <!-- Top Navigation Bar -->
    <header class="sticky top-0 z-50 glass-panel border-b border-zinc-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-9 h-9 rounded-xl bg-white text-black flex items-center justify-center font-black text-xl shadow-lg shadow-white/10">
                    ~
                </div>
                <span class="text-xl font-bold tracking-tight text-white dark:text-white light:text-black">
                    SignalSphere
                </span>
            </div>
            
            <nav class="hidden md:flex items-center space-x-1 text-sm font-medium text-zinc-400">
                <a href="#simulator" class="px-3 py-2 rounded-lg hover:text-white hover:bg-zinc-800/60 transition-colors">Simulator</a>
                <a href="#spectrum" class="px-3 py-2 rounded-lg hover:text-white hover:bg-zinc-800/60 transition-colors">Spectrum</a>
                <a href="#comparison" class="px-3 py-2 rounded-lg hover:text-white hover:bg-zinc-800/60 transition-colors">Matrix</a>
                <a href="#applications" class="px-3 py-2 rounded-lg hover:text-white hover:bg-zinc-800/60 transition-colors">Applications</a>
                <a href="#calculator" class="px-3 py-2 rounded-lg hover:text-white hover:bg-zinc-800/60 transition-colors">Math Lab</a>
            </nav>

            <div class="flex items-center space-x-3">
                <!-- Theme Toggle Button -->
                <button id="theme-toggle" onclick="toggleMonochromeTheme()" class="p-2 rounded-xl border border-zinc-700 bg-zinc-900 hover:bg-zinc-800 text-white transition-all flex items-center justify-center" title="Toggle Theme">
                    <svg id="sun-icon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                    <svg id="moon-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
                </button>

                <a href="#simulator" class="bg-white text-black hover:bg-zinc-200 font-semibold px-4 py-2 rounded-lg text-sm transition-all shadow-md flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Live Demo
                </a>
            </div>
        </div>
    </header>

    <section class="relative overflow-hidden py-20 lg:py-28 border-b border-zinc-900 reveal-on-scroll">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-300 mb-6">
                <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
                Monochrome Telecommunication & Networking Lab
            </div>
            
            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold text-white tracking-tight leading-tight max-w-4xl mx-auto">
                Understanding <span class="text-white underline decoration-zinc-600 decoration-wavy underline-offset-8">Baseband</span> & <span class="text-zinc-400">Broadband</span>
            </h1>
            
            <p class="mt-6 text-lg sm:text-xl text-zinc-400 max-w-2xl mx-auto font-normal leading-relaxed">
                Explore how digital networks transport data—from raw digital pulses to multi-channel modulated carrier waves in high contrast visual perfection.
            </p>

            <!-- Quick Action Cards -->
            <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto text-left">
                <!-- Baseband Card -->
                <div class="p-6 rounded-2xl bg-zinc-950 border border-zinc-800 hover:border-white transition-all glow-white group">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded-md bg-zinc-900 text-white border border-zinc-700">DIGITAL PULSES</span>
                        <svg class="w-6 h-6 text-white group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-2">Baseband Transmission</h3>
                    <p class="text-sm text-zinc-400 leading-relaxed">
                        Uses the <strong>entire bandwidth</strong> of a medium to transmit a single unmodulated digital signal (0s and 1s) over short distances.
                    </p>
                    <div class="mt-4 flex items-center text-xs font-mono text-zinc-300 gap-2">
                        <span>• Ethernet (802.3)</span>
                        <span>• USB / PCIe</span>
                        <span>• Bus Topology</span>
                    </div>
                </div>

                <!-- Broadband Card -->
                <div class="p-6 rounded-2xl bg-zinc-950 border border-zinc-800 hover:border-white transition-all glow-white group">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded-md bg-zinc-900 text-zinc-300 border border-zinc-700">MODULATED CARRIERS</span>
                        <svg class="w-6 h-6 text-zinc-300 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-2">Broadband Transmission</h3>
                    <p class="text-sm text-zinc-400 leading-relaxed">
                        Divides the frequency spectrum into <strong>multiple channels</strong> using analog carrier waves to transmit data simultaneously over long distances.
                    </p>
                    <div class="mt-4 flex items-center text-xs font-mono text-zinc-300 gap-2">
                        <span>• Cable TV (DOCSIS)</span>
                        <span>• Fiber Optic</span>
                        <span>• Wi-Fi & 5G</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="simulator" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 reveal-on-scroll">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
            <div>
                <span class="text-xs font-mono text-zinc-400 tracking-wider uppercase">Interactive Laboratory</span>
                <h2 class="text-3xl font-extrabold text-white mt-1">Real-Time Waveform Oscilloscope</h2>
                <p class="text-zinc-400 text-sm mt-1">Compare digital square pulses (Baseband) vs. frequency-multiplexed modulated sine waves (Broadband).</p>
            </div>
            
            <!-- Controls Bar -->
            <div class="flex items-center gap-3 bg-zinc-900 p-1.5 rounded-xl border border-zinc-800">
                <button id="btn-mode-baseband" onclick="switchSimulatorMode('baseband')" class="px-4 py-2 rounded-lg text-xs font-bold transition-all bg-white text-black shadow-md">
                    Baseband Mode
                </button>
                <button id="btn-mode-broadband" onclick="switchSimulatorMode('broadband')" class="px-4 py-2 rounded-lg text-xs font-bold transition-all text-zinc-400 hover:text-white">
                    Broadband Mode
                </button>
            </div>
        </div>

        <!-- Simulator Canvas Container -->
        <div class="rounded-2xl border border-zinc-800 bg-zinc-950 overflow-hidden shadow-2xl relative">
            
            <!-- Top Controls Toolbar -->
            <div class="p-4 border-b border-zinc-800/80 bg-zinc-900/60 flex flex-wrap items-center justify-between gap-4">
                <div class="flex flex-wrap items-center gap-4">
                    <div class="flex items-center gap-2">
                        <label class="text-xs font-mono text-zinc-400">Data Sequence:</label>
                        <input type="text" id="binary-input" value="10110010" maxlength="12" class="bg-black border border-zinc-700 text-white font-mono text-xs px-2.5 py-1.5 rounded-md w-28 focus:outline-none focus:border-white transition-colors" oninput="updateBinarySequence(this.value)">
                    </div>

                    <!-- Enhanced Speed Control Group -->
                    <div class="flex items-center gap-2 bg-black/60 p-1.5 rounded-xl border border-zinc-800">
                        <span class="text-xs font-mono text-zinc-400 px-1 font-semibold">Speed:</span>
                        <div class="flex items-center gap-1">
                            <button onclick="setSpeed(0.5)" data-speed="0.5" class="speed-btn px-2 py-1 rounded-md text-xs font-mono bg-zinc-800 text-zinc-400 hover:text-white transition-colors">0.5x</button>
                            <button onclick="setSpeed(1.0)" data-speed="1.0" class="speed-btn px-2 py-1 rounded-md text-xs font-mono bg-zinc-800 text-zinc-400 hover:text-white transition-colors">1x</button>
                            <button onclick="setSpeed(2.0)" data-speed="2.0" class="speed-btn px-2 py-1 rounded-md text-xs font-mono bg-white text-black font-bold transition-colors">2x</button>
                            <button onclick="setSpeed(4.0)" data-speed="4.0" class="speed-btn px-2 py-1 rounded-md text-xs font-mono bg-zinc-800 text-zinc-400 hover:text-white transition-colors">4x</button>
                        </div>
                        <input type="range" id="speed-range" min="0.5" max="5" step="0.5" value="2" class="w-16 sm:w-20 accent-white ml-1 cursor-pointer" oninput="updateSpeed(this.value)">
                        <span id="speed-val" class="text-xs font-mono text-white font-bold w-9 text-center bg-zinc-900 border border-zinc-700 px-1.5 py-0.5 rounded">2.0x</span>
                    </div>

                    <!-- Enhanced Noise Control Group -->
                    <div class="flex items-center gap-2 bg-black/60 p-1.5 rounded-xl border border-zinc-800">
                        <span class="text-xs font-mono text-zinc-400 px-1 font-semibold">Noise:</span>
                        <input type="range" id="noise-range" min="0" max="30" value="5" class="w-16 sm:w-20 accent-white cursor-pointer" oninput="updateNoise(this.value)">
                        <span id="noise-val" class="text-xs font-mono text-white font-bold w-9 text-center bg-zinc-900 border border-zinc-700 px-1.5 py-0.5 rounded">5%</span>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <span id="simulator-badge" class="text-xs font-mono px-3 py-1 rounded-full bg-zinc-800 text-white border border-zinc-700">
                        Mode: Single Digital Channel (NRZ Encoding)
                    </span>
                    <button onclick="togglePauseSimulator()" id="btn-pause" class="p-1.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs">
                        <svg id="icon-pause" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                    </button>
                </div>
            </div>

            <!-- Canvas Viewport -->
            <div class="relative w-full h-80 sm:h-96">
                <canvas id="signalCanvas" class="w-full h-full bg-black"></canvas>
                
                <!-- HUD Info Overlay -->
                <div id="canvas-hud" class="absolute bottom-4 left-4 p-3 rounded-lg bg-black/90 border border-zinc-800 text-xs font-mono space-y-1 pointer-events-none backdrop-blur">
                    <div class="text-zinc-400">Bandwidth Usage: <span id="hud-bw" class="text-white font-bold">100% Single Signal</span></div>
                    <div class="text-zinc-400">Transmission Type: <span id="hud-type" class="text-zinc-300">Unmodulated Digital Pulses</span></div>
                    <div class="text-zinc-400">Channel Count: <span id="hud-channels" class="text-white">1 Shared Bus</span></div>
                </div>
            </div>

            <!-- Interactive Description Banner -->
            <div id="simulator-info-box" class="p-4 bg-zinc-900/90 border-t border-zinc-800 text-sm text-zinc-300 leading-relaxed">
                <strong class="text-white font-mono">Baseband Mechanism:</strong> Voltage transitions directly encode raw 1s and 0s onto the conductor. Because square pulses require a continuous frequency spectrum down to 0 Hz (DC), no other channels can share this medium simultaneously without interference.
            </div>
        </div>
    </section>

    <section id="spectrum" class="py-16 bg-zinc-950/80 border-y border-zinc-900 reveal-on-scroll">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <span class="text-xs font-mono text-zinc-400 uppercase tracking-widest">Spectral Allocation</span>
                <h2 class="text-3xl font-extrabold text-white mt-1">Frequency Spectrum Breakdown</h2>
                <p class="text-zinc-400 text-sm mt-2">
                    Visualizing how frequency bands are partitioned in physical media for Baseband vs Broadband multiplexing (FDM).
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Baseband Spectrum Card -->
                <div class="p-6 rounded-2xl glass-panel border border-zinc-800 relative overflow-hidden">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-xl font-bold text-white flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-white inline-block"></span>
                            Baseband Spectrum
                        </h3>
                        <span class="text-xs font-mono px-2.5 py-1 rounded bg-zinc-900 text-zinc-300 border border-zinc-700">0 Hz to B_max</span>
                    </div>
                    
                    <p class="text-sm text-zinc-400 mb-6">
                        The raw signal monopolizes the complete frequency band from 0 Hz (Direct Current) up to the maximum media bandwidth limit.
                    </p>

                    <!-- Spectrum Bar Container -->
                    <div class="space-y-3 font-mono text-xs">
                        <div class="flex justify-between text-zinc-500">
                            <span>0 Hz (DC)</span>
                            <span>Channel Capacity Limit</span>
                        </div>
                        <div class="h-16 w-full rounded-xl bg-black p-1 border border-zinc-800 relative flex items-center">
                            <div class="h-full w-full bg-gradient-to-r from-zinc-700 via-zinc-400 to-white rounded-lg flex items-center justify-center font-bold text-black tracking-wider shadow-inner">
                                SINGLE EXCLUSIVE CHANNEL (Baseband Signal)
                            </div>
                        </div>
                        <div class="text-right text-zinc-500 text-2xs">Bidirectional or half-duplex baseband transmission</div>
                    </div>

                    <div class="mt-6 p-3 rounded-xl bg-zinc-900/60 border border-zinc-800/80 text-xs text-zinc-300">
                        <div class="font-bold text-white mb-1">Key Takeaway:</div>
                        No modulation involved. Simple hardware, but only one communication session can exist at a time per wire.
                    </div>
                </div>

                <!-- Broadband Spectrum Card -->
                <div class="p-6 rounded-2xl glass-panel border border-zinc-800 relative overflow-hidden">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-xl font-bold text-white flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-zinc-400 inline-block"></span>
                            Broadband Spectrum (FDM)
                        </h3>
                        <span class="text-xs font-mono px-2.5 py-1 rounded bg-zinc-900 text-zinc-300 border border-zinc-700">Frequency Division</span>
                    </div>

                    <p class="text-sm text-zinc-400 mb-6">
                        The spectrum is split into distinct, non-overlapping carrier frequency channels so voice, TV, and internet travel together.
                    </p>

                    <!-- Spectrum Bar Container -->
                    <div class="space-y-3 font-mono text-xs">
                        <div class="flex justify-between text-zinc-500">
                            <span>50 MHz</span>
                            <span>1 GHz+</span>
                        </div>
                        <div class="h-16 w-full rounded-xl bg-black p-1 border border-zinc-800 flex items-center gap-1.5">
                            <div class="h-full flex-1 bg-zinc-800 border border-zinc-700 rounded-md flex items-center justify-center text-white font-bold text-[10px] text-center px-1">
                                CH1: Voice
                            </div>
                            <div class="h-full flex-1 bg-zinc-700 border border-zinc-600 rounded-md flex items-center justify-center text-white font-bold text-[10px] text-center px-1">
                                CH2: Data
                            </div>
                            <div class="h-full flex-1 bg-zinc-500 border border-zinc-400 rounded-md flex items-center justify-center text-black font-bold text-[10px] text-center px-1">
                                CH3: Cable TV
                            </div>
                            <div class="h-full flex-1 bg-zinc-200 rounded-md flex items-center justify-center text-black font-bold text-[10px] text-center px-1">
                                CH4: Uplink
                            </div>
                        </div>
                        <div class="flex justify-around text-zinc-500 text-2xs">
                            <span>f₁ carrier</span>
                            <span>f₂ carrier</span>
                            <span>f₃ carrier</span>
                            <span>f₄ carrier</span>
                        </div>
                    </div>

                    <div class="mt-6 p-3 rounded-xl bg-zinc-900/60 border border-zinc-800/80 text-xs text-zinc-300">
                        <div class="font-bold text-white mb-1">Key Takeaway:</div>
                        Uses analog Modems (Modulator-Demodulator) to shift data to higher RF frequency bands, permitting massive parallel throughput.
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="comparison" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 reveal-on-scroll">
        <div class="text-center max-w-3xl mx-auto mb-12">
            <span class="text-xs font-mono text-zinc-400 uppercase tracking-widest">Engineering Comparison</span>
            <h2 class="text-3xl font-extrabold text-white mt-1">Feature Matrix & Technical Differences</h2>
            <p class="text-zinc-400 text-sm mt-2">Comprehensive breakdown of transmission attributes, range, components, and signal characteristics.</p>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-zinc-800 glass-panel shadow-2xl">
            <table class="w-full text-left text-sm border-collapse">
                <thead>
                    <tr class="bg-zinc-900 border-b border-zinc-800 text-xs font-mono text-zinc-400">
                        <th class="p-4 font-semibold uppercase tracking-wider">Feature</th>
                        <th class="p-4 font-semibold uppercase tracking-wider text-white bg-zinc-950/40">Baseband Transmission</th>
                        <th class="p-4 font-semibold uppercase tracking-wider text-zinc-300 bg-zinc-900/40">Broadband Transmission</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800/60 font-sans text-zinc-300">
                    <tr class="hover:bg-zinc-900/50 transition-colors">
                        <td class="p-4 font-semibold text-white">Signal Type</td>
                        <td class="p-4 text-white font-mono">Digital Pulses (Square Waves)</td>
                        <td class="p-4 text-zinc-300 font-mono">Analog Carrier Waves (Sine Waves)</td>
                    </tr>
                    <tr class="hover:bg-zinc-900/50 transition-colors">
                        <td class="p-4 font-semibold text-white">Modulation Required?</td>
                        <td class="p-4">No modulation (Direct voltage pulses)</td>
                        <td class="p-4">Yes (AM, FM, PSK, QAM modulation)</td>
                    </tr>
                    <tr class="hover:bg-zinc-900/50 transition-colors">
                        <td class="p-4 font-semibold text-white">Channel Multiplexing</td>
                        <td class="p-4">Time Division Multiplexing (TDM)</td>
                        <td class="p-4">Frequency Division Multiplexing (FDM)</td>
                    </tr>
                    <tr class="hover:bg-zinc-900/50 transition-colors">
                        <td class="p-4 font-semibold text-white">Transmission Distance</td>
                        <td class="p-4">Short distance (Typically &lt; 2 km due to attenuation)</td>
                        <td class="p-4">Long distance (Thousands of km with amplifiers)</td>
                    </tr>
                    <tr class="hover:bg-zinc-900/50 transition-colors">
                        <td class="p-4 font-semibold text-white">Directionality</td>
                        <td class="p-4">Bidirectional transmission on same line</td>
                        <td class="p-4">Unidirectional (Requires dual paths or distinct frequency bands)</td>
                    </tr>
                    <tr class="hover:bg-zinc-900/50 transition-colors">
                        <td class="p-4 font-semibold text-white">Bus Topology / Media</td>
                        <td class="p-4">Ethernet UTP (Cat5e/Cat6), Coaxial (50 Ω), USB</td>
                        <td class="p-4">Coaxial (75 Ω DOCSIS), Optical Fiber, Air (Wireless)</td>
                    </tr>
                    <tr class="hover:bg-zinc-900/50 transition-colors">
                        <td class="p-4 font-semibold text-white">Hardware Requirement</td>
                        <td class="p-4">Repeaters, Switches, Transceivers</td>
                        <td class="p-4">RF Amplifiers, Modems, Frequency Synthesizers</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

