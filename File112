    <script>
        // Global State variables
        let simMode = 'baseband';
        let binaryData = '10110010';
        let speed = 2;
        let noiseLevel = 5;
        let isPaused = false;
        let animationFrameId = null;
        let timeStep = 0;
        let isLightMode = false;

        window.addEventListener('load', () => {
            initCanvas();
            calculateCapacity();
            initScrollReveal();
            window.addEventListener('resize', handleCanvasResize);
        });

        function initScrollReveal() {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));
        }

        function toggleMonochromeTheme() {
            isLightMode = !isLightMode;
            const sunIcon = document.getElementById('sun-icon');
            const moonIcon = document.getElementById('moon-icon');
            
            if (isLightMode) {
                document.body.classList.remove('bg-black', 'text-zinc-100');
                document.body.classList.add('bg-white', 'text-black', 'light');
                sunIcon.classList.remove('hidden');
                moonIcon.classList.add('hidden');
            } else {
                document.body.classList.remove('bg-white', 'text-black', 'light');
                document.body.classList.add('bg-black', 'text-zinc-100');
                sunIcon.classList.add('hidden');
                moonIcon.classList.remove('hidden');
            }
        }

        const canvas = document.getElementById('signalCanvas');
        const ctx = canvas.getContext('2d');

        function handleCanvasResize() {
            const rect = canvas.parentElement.getBoundingClientRect();
            canvas.width = rect.width * window.devicePixelRatio;
            canvas.height = rect.height * window.devicePixelRatio;
            ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
        }

        function initCanvas() {
            handleCanvasResize();
            startAnimation();
        }

        function startAnimation() {
            function draw() {
                if (!isPaused) {
                    timeStep += speed * 0.8;
                }
                
                const width = canvas.width / window.devicePixelRatio;
                const height = canvas.height / window.devicePixelRatio;

                // Clear background grid
                ctx.fillStyle = isLightMode ? '#f4f4f5' : '#000000';
                ctx.fillRect(0, 0, width, height);

                // Draw Grid Lines
                ctx.strokeStyle = isLightMode ? '#e4e4e7' : '#18181b';
                ctx.lineWidth = 1;
                const gridSize = 30;
                
                ctx.beginPath();
                for (let x = 0; x < width; x += gridSize) {
                    ctx.moveTo(x, 0);
                    ctx.lineTo(x, height);
                }
                for (let y = 0; y < height; y += gridSize) {
                    ctx.moveTo(0, y);
                    ctx.lineTo(width, y);
                }
                ctx.stroke();

                // Draw Center Line
                ctx.strokeStyle = isLightMode ? '#a1a1aa' : '#3f3f46';
                ctx.beginPath();
                ctx.moveTo(0, height / 2);
                ctx.lineTo(width, height / 2);
                ctx.stroke();

                if (simMode === 'baseband') {
                    renderBasebandWave(width, height);
                } else {
                    renderBroadbandWave(width, height);
                }

                animationFrameId = requestAnimationFrame(draw);
            }
            draw();
        }

        function renderBasebandWave(width, height) {
            const bitWidth = 80;
            const centerY = height / 2;
            const amplitude = 60;
            const sequence = binaryData || '1010';

            ctx.save();
            ctx.shadowColor = isLightMode ? '#000000' : '#ffffff';
            ctx.shadowBlur = 10;
            ctx.strokeStyle = isLightMode ? '#000000' : '#ffffff';
            ctx.lineWidth = 3.5;

            ctx.beginPath();

            let isFirst = true;
            const totalWidth = sequence.length * bitWidth;

            for (let x = 0; x < width + bitWidth; x += 2) {
                const virtualX = (x + timeStep) % totalWidth;
                const bitIndex = Math.floor(virtualX / bitWidth) % sequence.length;
                const bitVal = sequence[bitIndex] === '1' ? 1 : -1;

                const noise = (Math.random() - 0.5) * (noiseLevel * 0.8);
                const targetY = centerY - (bitVal * amplitude) + noise;

                if (isFirst) {
                    ctx.moveTo(x, targetY);
                    isFirst = false;
                } else {
                    const prevVirtualX = ((x - 2) + timeStep) % totalWidth;
                    const prevBitIndex = Math.floor(prevVirtualX / bitWidth) % sequence.length;
                    
                    if (bitIndex !== prevBitIndex) {
                        ctx.lineTo(x, targetY);
                    } else {
                        ctx.lineTo(x, targetY);
                    }
                }
            }
            ctx.stroke();
            ctx.restore();

            // Render Bit Indicators on Top
            ctx.fillStyle = isLightMode ? '#3f3f46' : '#a1a1aa';
            ctx.font = '12px JetBrains Mono, monospace';
            for (let i = 0; i < width / bitWidth + 2; i++) {
                const xPos = (i * bitWidth) - (timeStep % bitWidth);
                const bitIndex = Math.floor(((xPos + timeStep) % totalWidth) / bitWidth) % sequence.length;
                if (xPos >= 0 && xPos <= width) {
                    const currentBit = sequence[bitIndex] || '0';
                    ctx.fillText(`Bit: ${currentBit}`, xPos + 25, 30);
                    
                    // Vertical bit boundary guidelines
                    ctx.strokeStyle = isLightMode ? '#d4d4d8' : '#27272a';
                    ctx.setLineDash([4, 4]);
                    ctx.beginPath();
                    ctx.moveTo(xPos, 0);
                    ctx.lineTo(xPos, height);
                    ctx.stroke();
                    ctx.setLineDash([]);
                }
            }
        }

        function renderBroadbandWave(width, height) {
            const centerY = height / 2;
            
            // Monochrome Channel Palette
            const channels = [
                { name: 'Channel 1 (Voice)', color: isLightMode ? '#71717a' : '#52525b', freq: 0.03, amp: 25, offset: 0 },
                { name: 'Channel 2 (Data)', color: isLightMode ? '#a1a1aa' : '#71717a', freq: 0.08, amp: 20, offset: 2 },
                { name: 'Channel 3 (Video)', color: isLightMode ? '#d4d4d8' : '#a1a1aa', freq: 0.15, amp: 15, offset: 4 }
            ];

            // Render individual subchannels
            channels.forEach((ch, idx) => {
                ctx.save();
                ctx.strokeStyle = ch.color;
                ctx.lineWidth = 1.5;
                ctx.globalAlpha = 0.6;
                ctx.beginPath();

                for (let x = 0; x < width; x += 2) {
                    const noise = (Math.random() - 0.5) * (noiseLevel * 0.4);
                    const y = centerY + Math.sin((x + timeStep * (idx + 1)) * ch.freq + ch.offset) * ch.amp + noise;
                    if (x === 0) ctx.moveTo(x, y);
                    else ctx.lineTo(x, y);
                }
                ctx.stroke();
                ctx.restore();
            });

            // Composite Carrier Wave
            ctx.save();
            ctx.shadowColor = isLightMode ? '#000000' : '#ffffff';
            ctx.shadowBlur = 12;
            ctx.strokeStyle = isLightMode ? '#000000' : '#ffffff';
            ctx.lineWidth = 2.5;
            ctx.beginPath();

            for (let x = 0; x < width; x += 2) {
                let compositeY = centerY;
                channels.forEach((ch, idx) => {
                    compositeY += Math.sin((x + timeStep * (idx + 1)) * ch.freq + ch.offset) * (ch.amp * 0.7);
                });
                const noise = (Math.random() - 0.5) * noiseLevel;
                compositeY += noise;

                if (x === 0) ctx.moveTo(x, compositeY);
                else ctx.lineTo(x, compositeY);
            }
            ctx.stroke();
            ctx.restore();

            // Overlay label
            ctx.fillStyle = isLightMode ? '#18181b' : '#f4f4f5';
            ctx.font = '11px JetBrains Mono';
            ctx.fillText("Composite Multi-Carrier Signal (FDM)", 15, 30);
        }

        function switchSimulatorMode(mode) {
            simMode = mode;
            const btnBaseband = document.getElementById('btn-mode-baseband');
            const btnBroadband = document.getElementById('btn-mode-broadband');
            const badge = document.getElementById('simulator-badge');
            const infoBox = document.getElementById('simulator-info-box');

            const hudBw = document.getElementById('hud-bw');
            const hudType = document.getElementById('hud-type');
            const hudChannels = document.getElementById('hud-channels');

            if (mode === 'baseband') {
                btnBaseband.className = "px-4 py-2 rounded-lg text-xs font-bold transition-all bg-white text-black shadow-md";
                btnBroadband.className = "px-4 py-2 rounded-lg text-xs font-bold transition-all text-zinc-400 hover:text-white";
                badge.className = "text-xs font-mono px-3 py-1 rounded-full bg-zinc-800 text-white border border-zinc-700";
                badge.innerText = "Mode: Single Digital Channel (NRZ Encoding)";

                hudBw.innerText = "100% Single Signal";
                hudType.innerText = "Unmodulated Digital Voltage Pulses";
                hudChannels.innerText = "1 Shared Bus";

                infoBox.innerHTML = `<strong class="text-white font-mono">Baseband Mechanism:</strong> Voltage transitions directly encode raw 1s and 0s onto the conductor. Because square pulses require a continuous frequency spectrum down to 0 Hz (DC), no other channels can share this medium simultaneously without interference.`;
            } else {
                btnBroadband.className = "px-4 py-2 rounded-lg text-xs font-bold transition-all bg-zinc-200 text-black shadow-md";
                btnBaseband.className = "px-4 py-2 rounded-lg text-xs font-bold transition-all text-zinc-400 hover:text-white";
                badge.className = "text-xs font-mono px-3 py-1 rounded-full bg-zinc-800 text-zinc-300 border border-zinc-700";
                badge.innerText = "Mode: Multi-Channel Analog Carrier Multiplexing (FDM)";

                hudBw.innerText = "Split Spectrum (FDM)";
                hudType.innerText = "Modulated High-Frequency Carriers";
                hudChannels.innerText = "Multiple Parallel Channels";

                infoBox.innerHTML = `<strong class="text-zinc-200 font-mono">Broadband Mechanism:</strong> Uses high-frequency carrier wave modulation (AM/FM/QAM). Multiple data streams are modulated onto distinct center frequencies, permitting high-capacity simultaneous voice, TV, and data transmission.`;
            }
        }

        function updateBinarySequence(val) {
            binaryData = val.replace(/[^01]/g, '') || '1010';
        }

        function setSpeed(val) {
            document.getElementById('speed-range').value = val;
            updateSpeed(val);
        }

        function updateSpeed(val) {
            speed = parseFloat(val);
            const speedVal = document.getElementById('speed-val');
            if (speedVal) speedVal.innerText = `${speed.toFixed(1)}x`;

            // Highlight active speed button preset if matching
            document.querySelectorAll('.speed-btn').forEach(btn => {
                const btnSpeed = parseFloat(btn.dataset.speed);
                if (Math.abs(btnSpeed - speed) < 0.1) {
                    btn.className = "speed-btn px-2 py-1 rounded-md text-xs font-mono bg-white text-black font-bold transition-colors";
                } else {
                    btn.className = "speed-btn px-2 py-1 rounded-md text-xs font-mono bg-zinc-800 text-zinc-400 hover:text-white transition-colors";
                }
            });
        }

        function updateNoise(val) {
            noiseLevel = parseFloat(val);
            const noiseVal = document.getElementById('noise-val');
            if (noiseVal) noiseVal.innerText = `${Math.round(noiseLevel)}%`;
        }

        function togglePauseSimulator() {
            isPaused = !isPaused;
            const btn = document.getElementById('btn-pause');
            if (isPaused) {
                btn.innerHTML = `<svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>`;
            } else {
                btn.innerHTML = `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>`;
            }
        }

        function calculateCapacity() {
            const bw = parseFloat(document.getElementById('input-bw').value);
            const levels = parseInt(document.getElementById('input-levels').value);
            const snrDb = parseFloat(document.getElementById('input-snr').value);

            document.getElementById('calc-bw-val').innerText = `${bw} MHz`;
            document.getElementById('calc-levels-val').innerText = `${levels} Levels (${Math.log2(levels)} bits/symbol)`;
            document.getElementById('calc-snr-val').innerText = `${snrDb} dB`;

            // Nyquist Formula
            const nyquistBps = 2 * (bw * 1e6) * Math.log2(levels);
            const nyquistMbps = (nyquistBps / 1e6).toFixed(2);

            // Shannon Formula
            const snrLinear = Math.pow(10, snrDb / 10);
            const shannonBps = (bw * 1e6) * Math.log2(1 + snrLinear);
            const shannonMbps = (shannonBps / 1e6).toFixed(2);

            document.getElementById('res-nyquist').innerText = `${nyquistMbps} Mbps`;
            document.getElementById('res-shannon').innerText = `${shannonMbps} Mbps`;
        }
    </script>
</body>
</html>
